#!/usr/bin/env lush

local repo = env.cwd()
local lib_dir = path.join(repo, "lib")
local home = env.get("HOME")

local function quote(value)
	return "'" .. tostring(value):gsub("'", "'\\''") .. "'"
end

local function run(cmd)
	local ok = os.execute(cmd)
	if not ok then
		io.stderr:write("failed: " .. cmd .. "\n")
		return false
	end
	return true
end

local function ensure_dir(dir)
	if not fs.is_dir(dir) then
		fs.mkdir(dir)
	end
end

local function readlink(target)
	local result = os.pipeline({"readlink", "-f", target})
	return ((result or ""):gsub("%s+$", ""))
end

local function has_cmd(cmd)
	return os.execute("command -v " .. cmd .. " >/dev/null 2>&1") == true
end

local function link(target, link_path)
	if not fs.exists(link_path) then
		run("ln -s " .. quote(target) .. " " .. quote(link_path))
	end
end

local runtime_deps = {
	{ cmd = "river",         pkg = "river" },
	{ cmd = "noctalia",      pkg = "noctalia" },
	{ cmd = "neovide",       pkg = "neovide" },
	{ cmd = "tv",            pkg = "television" },
	{ cmd = "bat",           pkg = "bat" },
	{ cmd = "rg",            pkg = "ripgrep" },
	{ cmd = "git",           pkg = "git" },
	{ cmd = "wl-copy",       pkg = "wl-clipboard" },
	{ cmd = "tree-sitter",   pkg = "tree-sitter-cli" },
	{ cmd = "cosmic-files",  pkg = "cosmic-files" },
	{ cmd = "cosmic-player", pkg = "cosmic-player" },
	{ cmd = "cosmic-viewer", pkg = "cosmic-viewer" },
	{ cmd = "starship",      pkg = "starship" },
	{ cmd = "tombi",         pkg = "tombi" },
}

local optional_deps = {
	{ cmd = "tofi",                pkg = "tofi (AUR)" },
	{ cmd = "noctalia-greeter",    pkg = "noctalia-greeter" },
	{ cmd = "lua-language-server", pkg = "lua-language-server" },
}

local function check_runtime_deps()
	local missing = {}
	for _, dep in ipairs(runtime_deps) do
		if not has_cmd(dep.cmd) then
			missing[#missing + 1] = dep.pkg
		end
	end
	if not has_cmd("upower") and not fs.exists("/usr/lib/upowerd") then
		missing[#missing + 1] = "upower"
	end

	local missing_opt = {}
	for _, dep in ipairs(optional_deps) do
		if not has_cmd(dep.cmd) then
			missing_opt[#missing_opt + 1] = dep.pkg
		end
	end
	if #missing_opt > 0 then
		print("optional not installed: " .. table.concat(missing_opt, ", "))
	end

	if #missing > 0 then
		io.stderr:write("missing dependencies: " .. table.concat(missing, ", ") .. "\n")
		io.stderr:write("install with: sudo pacman -S " .. table.concat(missing, " ") .. "\n")
		return false
	end
	return true
end

local function ensure_paru()
	if has_cmd("paru") or not has_cmd("makepkg") then
		return true
	end
	local build_dir = os.mkdtemp()
	if not run("git clone --depth 1 https://aur.archlinux.org/paru-bin.git " .. quote(build_dir .. "/src")) then
		return false
	end
	local ok = run("cd " .. quote(build_dir .. "/src") .. " && makepkg -si --noconfirm")
	return ok
end

local function ensure_lush()
	local lush_dir = path.join(lib_dir, "lush-unsafe")
	local lush_bin = path.join(repo, "bin", "lush")

	if not fs.is_dir(path.join(lush_dir, ".git")) then
		if not run("git clone --depth 1 git@github.com:aquarockslug/lush-unsafe.git " .. quote(lush_dir)) then
			return false
		end
	end

	if not fs.exists(lush_bin) then
		fs.copy(path.join(lush_dir, "lush"), lush_bin)
		run("chmod +x " .. quote(lush_bin))
	end

	return true
end

local function install_fonts()
	local fonts_src = path.join(repo, "fonts")
	if not fs.is_dir(fonts_src) then
		return
	end
	local data_dir = env.get("XDG_DATA_HOME")
	if not data_dir or data_dir == "" then
		data_dir = path.join(home, ".local", "share")
	end
	local fonts_dest = path.join(data_dir, "fonts")
	ensure_dir(fonts_dest)

	for _, file_path in ipairs(fs.ls(fonts_src) or {}) do
		if file_path:endswith(".otf") or file_path:endswith(".ttf") then
			fs.copy(file_path, fonts_dest)
		end
	end
	if has_cmd("fc-cache") then
		run("fc-cache -f " .. quote(fonts_dest))
	end
end

local function ensure_cffi_lua()
	local cffi_so = path.join(lib_dir, "cffi.so")
	if fs.exists(cffi_so) then
		return true
	end
	for _, tool in ipairs({ "gcc", "pkg-config", "meson", "ninja" }) do
		if not has_cmd(tool) then
			io.stderr:write("missing build tool: " .. tool .. " (sudo pacman -S base-devel meson ninja)\n")
			return false
		end
	end

	local cffi_dir = path.join(lib_dir, "cffi-lua")
	if not fs.is_dir(path.join(cffi_dir, ".git")) then
		if not run("git clone --depth 1 https://github.com/q66/cffi-lua.git " .. quote(cffi_dir)) then
			return false
		end
	end

	env.pushd(cffi_dir)
	local ok = run("meson setup build -Dtests=false -Dlua_version=5.4")
	            and run("ninja -C build")
	env.popd()

	local built = path.join(cffi_dir, "build", "cffi.so")
	if not ok or not fs.exists(built) then
		return false
	end
	fs.copy(built, cffi_so)
	return true
end

local function install_xml2lua()
	if fs.exists(path.join(lib_dir, "xml2lua.lua")) then
		return true
	end
	local temp_dir = os.mkdtemp()
	if not run("git clone --depth 1 https://github.com/ManoelCampos/xml2lua.git " .. quote(temp_dir .. "/src")) then
		return false
	end
	ensure_dir(path.join(lib_dir, "xmlhandler"))
	fs.copy(path.join(temp_dir, "src", "xml2lua.lua"), path.join(lib_dir, "xml2lua.lua"))
	fs.copy(path.join(temp_dir, "src", "XmlParser.lua"), path.join(lib_dir, "XmlParser.lua"))
	for _, file_path in ipairs(fs.ls(path.join(temp_dir, "src", "xmlhandler")) or {}) do
		fs.copy(file_path, path.join(lib_dir, "xmlhandler"))
	end
	return true
end

local function install_wau()
	local wau_dir = path.join(lib_dir, "wau")
	local scanner = path.join(lib_dir, "wau-scanner.lua")
	if fs.is_dir(wau_dir) and fs.exists(scanner) then
		return true
	end
	local temp_dir = os.mkdtemp()
	if not run("git clone --depth 1 https://codeberg.org/firefly/wau.git " .. quote(temp_dir .. "/src")) then
		return false
	end
	run("cp -r " .. quote(path.join(temp_dir, "src", "wau")) .. " " .. quote(lib_dir))
	fs.copy(path.join(temp_dir, "src", "wau-scanner.lua"), scanner)
	return fs.is_dir(wau_dir)
end

local function generate_protocol_bindings()
	local protocol_dir = path.join(repo, "wm", "protocol")
	local lush_bin = path.join(repo, "bin", "lush")
	local scanner = path.join(lib_dir, "wau-scanner.lua")

	env.set("LUA_CPATH", lib_dir .. "/?.so;;")
	env.set("LUA_PATH", lib_dir .. "/?.lua;" .. lib_dir .. "/?/init.lua;;")

	for _, file_path in ipairs(fs.ls(protocol_dir) or {}) do
		if file_path:endswith(".xml") then
			local out_path = file_path:gsub("%.xml$", ".lua")
			local cmd = quote(lush_bin) .. " " .. quote(scanner)
				.. " < " .. quote(file_path) .. " > " .. quote(out_path)
			if not run(cmd) then
				return false
			end
		end
	end
	return true
end

local default_tv_theme = {
	border_fg = "#44415a",
	text_fg = "#e0def4",
	dimmed_text_fg = "#908caa",
	input_text_fg = "#ea9a97",
	result_count_fg = "#9ccfd8",
	result_name_fg = "#ea9a97",
	result_line_number_fg = "#32758f",
	result_value_fg = "#e0def4",
	selection_fg = "#ea9a97",
	selection_bg = "#393552",
	match_fg = "#9ccfd8",
	preview_title_fg = "#9ccfd8",
	channel_mode_fg = "#232136",
	channel_mode_bg = "#ea9a97",
	remote_control_mode_fg = "#232136",
	remote_control_mode_bg = "#9ccfd8",
	action_picker_mode_fg = "#d0cdee",
	action_picker_mode_bg = "#32758f",
}

local function setup_shells()
	local shell_toml_path = path.join(repo, "toml", "shell.toml")
	if not fs.exists(shell_toml_path) then
		return true
	end

	local shell_cfg = toml.load_file(shell_toml_path)
	local config_dir = env.get("XDG_CONFIG_HOME")
	if not config_dir or config_dir == "" then
		config_dir = path.join(home, ".config")
	end

	-- Generate Bash config
	local bash_lines = {}
	bash_lines[#bash_lines + 1] = "# Generated from ~/.aquamoon/toml/shell.toml"
	bash_lines[#bash_lines + 1] = "# Edit that file instead of this one"
	bash_lines[#bash_lines + 1] = ""
	bash_lines[#bash_lines + 1] = "# If not running interactively, don't do anything"
	bash_lines[#bash_lines + 1] = "[[ $- != *i* ]] && return"
	bash_lines[#bash_lines + 1] = ""

	-- Aliases
	if shell_cfg.aliases then
		bash_lines[#bash_lines + 1] = "# Aliases"
		for name, cmd in pairs(shell_cfg.aliases) do
			bash_lines[#bash_lines + 1] = string.format("alias %s='%s'", name, cmd:gsub("'", "'\\''"))
		end
		bash_lines[#bash_lines + 1] = ""
	end

	-- Environment variables
	if shell_cfg.env then
		bash_lines[#bash_lines + 1] = "# Environment variables"
		for name, value in pairs(shell_cfg.env) do
			if name ~= "paths" and type(value) == "string" then
				bash_lines[#bash_lines + 1] = string.format('export %s="%s"', name, value)
			end
		end
		bash_lines[#bash_lines + 1] = ""
	end

	-- PATH additions
	if shell_cfg.env and shell_cfg.env.paths then
		bash_lines[#bash_lines + 1] = "# PATH additions"
		for p, _ in pairs(shell_cfg.env.paths) do
			bash_lines[#bash_lines + 1] = string.format('export PATH="%s:$PATH"', p)
		end
		bash_lines[#bash_lines + 1] = ""
	end

	-- Functions
	if shell_cfg.functions then
		bash_lines[#bash_lines + 1] = "# Functions"
		for name, fn in pairs(shell_cfg.functions) do
			if fn.description then
				bash_lines[#bash_lines + 1] = "# " .. fn.description
			end
			bash_lines[#bash_lines + 1] = name .. "() {"
			bash_lines[#bash_lines + 1] = "    " .. fn.command
			bash_lines[#bash_lines + 1] = "}"
		end
		bash_lines[#bash_lines + 1] = ""
	end

	-- Shell options
	if shell_cfg["shell-options"] then
		bash_lines[#bash_lines + 1] = "# Shell options"
		if shell_cfg["shell-options"].set_options then
			for _, opt in ipairs(shell_cfg["shell-options"].set_options) do
				bash_lines[#bash_lines + 1] = "set -o " .. opt
			end
		end
		if shell_cfg["shell-options"].bash and shell_cfg["shell-options"].bash.shopt then
			for _, opt in ipairs(shell_cfg["shell-options"].bash.shopt) do
				bash_lines[#bash_lines + 1] = "shopt -s " .. opt
			end
		end
		bash_lines[#bash_lines + 1] = ""
	end

	-- Startup commands
	if shell_cfg.startup then
		bash_lines[#bash_lines + 1] = "# Startup commands"
		if shell_cfg.startup.commands then
			for _, cmd in ipairs(shell_cfg.startup.commands) do
				bash_lines[#bash_lines + 1] = cmd
			end
		end
		bash_lines[#bash_lines + 1] = ""
	end

	local bashrc_path = path.join(home, ".bashrc")
	fs.write_file(bashrc_path, table.concat(bash_lines, "\n"))
	print("generated " .. bashrc_path)

	-- Generate Fish config
	local fish_lines = {}
	fish_lines[#fish_lines + 1] = "# Generated from ~/.aquamoon/toml/shell.toml"
	fish_lines[#fish_lines + 1] = "# Edit that file instead of this one"
	fish_lines[#fish_lines + 1] = ""
	fish_lines[#fish_lines + 1] = "if status is-interactive"

	-- Aliases
	if shell_cfg.aliases then
		fish_lines[#fish_lines + 1] = "    # Aliases"
		for name, cmd in pairs(shell_cfg.aliases) do
			fish_lines[#fish_lines + 1] = string.format("    alias %s '%s'", name, cmd:gsub("'", "'\\''"))
		end
		fish_lines[#fish_lines + 1] = ""
	end

	-- Environment variables
	if shell_cfg.env then
		fish_lines[#fish_lines + 1] = "    # Environment variables"
		for name, value in pairs(shell_cfg.env) do
			if name ~= "paths" and type(value) == "string" then
				fish_lines[#fish_lines + 1] = string.format('    set -gx %s "%s"', name, value)
			end
		end
		fish_lines[#fish_lines + 1] = ""
	end

	-- PATH additions
	if shell_cfg.env and shell_cfg.env.paths then
		fish_lines[#fish_lines + 1] = "    # PATH additions"
		for p, _ in pairs(shell_cfg.env.paths) do
			fish_lines[#fish_lines + 1] = string.format('    fish_add_path %s', p)
		end
		fish_lines[#fish_lines + 1] = ""
	end

	-- Functions
	if shell_cfg.functions then
		fish_lines[#fish_lines + 1] = "    # Functions"
		for name, fn in pairs(shell_cfg.functions) do
			if fn.description then
				fish_lines[#fish_lines + 1] = "    # " .. fn.description
			end
			-- Transform Bash-style args to Fish-style
			local fish_cmd = fn.command
				:gsub("%$@", "$argv")
				:gsub("%$1", "$argv[1]")
				:gsub("%$2", "$argv[2]")
				:gsub("%$3", "$argv[3]")
			fish_lines[#fish_lines + 1] = "    function " .. name
			fish_lines[#fish_lines + 1] = "        " .. fish_cmd
			fish_lines[#fish_lines + 1] = "    end"
		end
		fish_lines[#fish_lines + 1] = ""
	end

	fish_lines[#fish_lines + 1] = "end"
	fish_lines[#fish_lines + 1] = ""

	-- Fish-specific startup
	if shell_cfg.startup and shell_cfg.startup.fish and shell_cfg.startup.fish.commands then
		fish_lines[#fish_lines + 1] = "# Fish-specific startup"
		for _, cmd in ipairs(shell_cfg.startup.fish.commands) do
			fish_lines[#fish_lines + 1] = cmd
		end
	end

	local fish_dir = path.join(config_dir, "fish")
	ensure_dir(fish_dir)
	local fish_config_path = path.join(fish_dir, "config.fish")
	fs.write_file(fish_config_path, table.concat(fish_lines, "\n"))
	print("generated " .. fish_config_path)

	return true
end

local function setup_session()
	local default_repo = path.join(home, ".aquamoon")
	if readlink(default_repo) ~= readlink(repo) then
		link(repo, default_repo)
	end

	local config_dir = env.get("XDG_CONFIG_HOME")
	if not config_dir or config_dir == "" then
		config_dir = path.join(home, ".config")
	end

	for _, sub in ipairs({ "river", "haal", "television", "television/cable", "television/themes" }) do
		ensure_dir(path.join(config_dir, sub))
	end

	local init_path = path.join(config_dir, "river", "init")
	fs.write_file(init_path, "#!/bin/sh\nexec " .. quote(path.join(repo, "bin", "wm")) .. "\n")
	run("chmod +x " .. quote(init_path) .. " " .. quote(path.join(repo, "bin", "wm"))
		.. " " .. quote(path.join(repo, "bin", "haal")))

	local state_dir = env.get("XDG_STATE_HOME")
	if not state_dir or state_dir == "" then
		state_dir = path.join(home, ".local", "state")
	end
	local noctalia_state = path.join(state_dir, "noctalia")
	ensure_dir(noctalia_state)
	local storage_key = path.join(noctalia_state, "storage.key")
	if not fs.exists(storage_key) then
		run("umask 077 && od -An -N32 -tx1 /dev/urandom | tr -d ' \\n' > "
			.. quote(storage_key) .. " && echo >> " .. quote(storage_key))
	end

	local noctalia_dir = path.join(config_dir, "noctalia")
	if readlink(noctalia_dir) == readlink(repo) then
		fs.rm(noctalia_dir)
	end
	ensure_dir(noctalia_dir)
	local noctalia_config = path.join(noctalia_dir, "config.toml")
	fs.write_file(noctalia_config, '[include]\nfiles = ["' .. path.join(repo, "toml", "noctalia.toml") .. '"]\n')
	link(path.join(repo, "palettes"), path.join(noctalia_dir, "palettes"))

	link(repo, path.join(config_dir, "nvim"))
	link(path.join(repo, "toml", "starship.toml"), path.join(config_dir, "starship.toml"))
	link(path.join(repo, "lua", "haal-fetch.lua"), path.join(config_dir, "haal", "init.lua"))

	local tv_dir = path.join(config_dir, "television")
	run("ln -sf " .. quote(path.join(repo, "toml", "television.toml")) .. " "
		.. quote(path.join(tv_dir, "config.toml")))

	local cable_src = path.join(repo, "cable")
	for _, file_path in ipairs(fs.ls(cable_src) or {}) do
		if file_path:endswith(".toml") then
			local filename = file_path:match("([^/]+)$")
			run("ln -sf " .. quote(file_path) .. " "
				.. quote(path.join(tv_dir, "cable", filename)))
		end
	end

	local tv_theme = path.join(tv_dir, "themes", "noctalia.toml")
	if not fs.exists(tv_theme) then
		toml.save_file(tv_theme, default_tv_theme)
	end
	return true
end

local function setup_greeter()
	if not has_cmd("noctalia-greeter") then
		return
	end
	local user = env.get("GREETER_USER")
	if not user or user == "" then
		user = os.pipeline({"noctalia-greeter-apply-appearance", "--print-greeter-user"}) or ""
		user = user:gsub("%s+$", "")
		if user == "" then
			user = "greeter"
		end
	end

	local login_user = env.get("SUDO_USER")
	if not login_user or login_user == "" then
		login_user = env.get("USER")
	end

	local dir = "/var/lib/noctalia-greeter"
	local config = path.join(repo, "toml", "noctalia-greeter.toml")
	local wallpaper = path.join(repo, "wallpapers", "macos_tiger_grey.png")
	local fonts_src = path.join(repo, "fonts")
	local sys_fonts = "/usr/local/share/fonts/aquamoon"

	local cmds = {
		"install -d -m750 -o " .. quote(user) .. " -g " .. quote(user) .. " " .. quote(dir),
		"install -Dm644 " .. quote(config) .. " " .. quote(path.join(dir, "greeter.toml")),
		"install -Dm644 " .. quote(wallpaper) .. " " .. quote(path.join(dir, "wallpaper.png")),
	}
	if login_user and login_user ~= "" then
		cmds[#cmds + 1] = "sed -i " .. quote('s/^default = "aqua"/default = "' .. login_user .. '"/')
		    .. " " .. quote(path.join(dir, "greeter.toml"))
	end
	cmds[#cmds + 1] = "chown " .. quote(user .. ":" .. user) .. " " .. quote(dir) .. " "
	    .. quote(path.join(dir, "greeter.toml")) .. " " .. quote(path.join(dir, "wallpaper.png"))

	if fs.is_dir(fonts_src) then
		cmds[#cmds + 1] = "install -d -m755 " .. quote(sys_fonts)
		cmds[#cmds + 1] = "install -m644 " .. quote(fonts_src) .. "/*.[to]tf " .. quote(sys_fonts) .. "/"
		if has_cmd("fc-cache") then
			cmds[#cmds + 1] = "fc-cache -f " .. quote(sys_fonts)
		end
	end

	run("sudo sh -c " .. quote(table.concat(cmds, " && ")))
end

local function setup_greetd()
	if not has_cmd("greetd") or not has_cmd("noctalia-greeter") then
		return
	end

	local config = table.concat({
		"[terminal]",
		"vt = 1",
		"",
		"[default_session]",
		'command = "/usr/bin/noctalia-greeter-session"',
		'user = "greeter"',
		"",
	}, "\n")
	local temp = "/tmp/aquamoon-greetd.toml"
	fs.write_file(temp, config)

	local cmds = {
		"useradd -r -s /usr/bin/nologin -d /var/lib/noctalia-greeter greeter 2>/dev/null || true",
		"cp -a /etc/greetd/config.toml /etc/greetd/config.toml.bak 2>/dev/null || true",
		"install -Dm644 " .. quote(temp) .. " /etc/greetd/config.toml",
		"rm -f " .. quote(temp),
	}
	if not run("sudo sh -c " .. quote(table.concat(cmds, " && "))) then
		return
	end
	if run("sudo systemctl enable greetd") then
		print("greetd configured; restart it with: sudo systemctl restart greetd")
	end
end

local function main()
	if not check_runtime_deps() then
		return 1
	end
	ensure_paru()
	install_fonts()
	ensure_dir(lib_dir)

	if not ensure_lush() then
		return 1
	end

	if not ensure_cffi_lua() or not install_xml2lua() or not install_wau() or not generate_protocol_bindings() then
		return 1
	end
	setup_session()
	setup_shells()
	setup_greeter()
	setup_greetd()
	print("setup complete; start with: river")
	return 0
end

os.exit(main())
