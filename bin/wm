#!/bin/sh
# SPDX-FileCopyrightText: © 2026 FireFly
# SPDX-License-Identifier: 0BSD
#
# Launch the window manager vendored in this repository.  Everything the
# session needs lives under wm/ and lua/, so changes made here are used
# directly the next time river starts (no install step).

set -eu

self=$(readlink -f -- "$0")
repo=$(dirname -- "$(dirname -- "$self")")

eval "$(luarocks --lua-version=5.4 path)"

# Keep the configuration in sync with the checkout that owns this launcher.
export AQUAMOON_DIR="$repo"
export LUA_PATH="$repo/?.lua;$repo/?/init.lua;$repo/lua/?.lua;${LUA_PATH:-}"

exec lua5.4 "$repo/wm/wm.lua" "$@"
