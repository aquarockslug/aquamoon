#!/bin/sh
set -eu

self=$(readlink -f -- "$0")
repo=$(dirname -- "$(dirname -- "$self")")

export AQUAMOON_DIR="$repo"
export XDG_CURRENT_DESKTOP="${XDG_CURRENT_DESKTOP:-river}"
export XDG_SESSION_TYPE="${XDG_SESSION_TYPE:-wayland}"
export LUA_CPATH="$repo/lib/?.so;;"
export LUA_PATH="$repo/lib/?.lua;$repo/lib/?/init.lua;$repo/?.lua;$repo/?/init.lua;$repo/lua/?.lua;;"

exec "$repo/bin/lush" --unsafe-mode "$repo/wm/wm.lua" "$@"
